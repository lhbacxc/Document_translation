# Paper Detection Skill - .gitignore

# 环境状态文件（包含本地路径，不应提交）
.env_status.json

# 虚拟环境目录
.venv_paper_detection/
venv/
env/

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# 编译文件
*.so
*.egg
*.egg-info/
dist/
build/

# Jupyter Notebook
.ipynb_checkpoints

# 测试覆盖率
.coverage
htmlcov/

# 日志文件
*.log

# IDE 配置
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统文件
.DS_Store
Thumbs.db
Desktop.ini

# 临时文件
*.tmp
*.bak
*.backup
